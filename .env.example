# AthleteBridge Environment Configuration
# Copy this file to .env for local overrides (never commit real production secrets)

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./athletebridge.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/athletebridge

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Security
ENVIRONMENT=development
DEMO_MODE=true

# Frontend Configuration (Vite)
VITE_API_BASE_URL=/api
